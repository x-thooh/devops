# 本地覆盖（env/.env 由 scripts/gen-secrets.sh 生成，chmod 600，gitignore）
# 默认值即官方镜像；需要镜像加速时取消注释。
ENTRY_HTTP_PORT=80
TZ=Asia/Shanghai

# 镜像整体前缀（镜像加速器 / 私有仓库），默认空 = 官方源
# IMAGE_PREFIX=
# 单个镜像覆盖，键名对应 base/images.yml
# IMG_nginx=nginx:1.27-alpine

# 凭据（P0 尚未使用；由 gen-secrets.sh 生成随机值）
# PG_SUPERUSER_PASSWORD=
# MYSQL_ROOT_PASSWORD=
# MYSQL_REPL_PASSWORD=
# MONGO_ROOT_PASSWORD=
# REDIS_PASSWORD=
# GRAFANA_ADMIN_PASSWORD=
# NACOS_TOKEN_SECRET_KEY=
