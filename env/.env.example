# 本地覆盖（env/.env 由 scripts/gen-secrets.sh 生成，chmod 600，gitignore）
# 默认值即官方镜像；需要镜像加速时取消注释。
# HTTP_PORT = 宿主侧入口端口（容器内 nginx 固定监听 80），只用于 compose 的 ports 映射
HTTP_PORT=80
TZ=Asia/Shanghai

# 镜像整体前缀（镜像加速器 / 私有仓库），默认空 = 官方源
# IMAGE_PREFIX=
# 单个镜像覆盖，键名对应 base/images.yml
# IMG_nginx=nginx:1.27-alpine

# 凭据（P0 尚未使用；由 gen-secrets.sh 生成随机值）
# PG_SUPERUSER_PASSWORD=
# MYSQL_ROOT_PASSWORD=
# MYSQL_REPL_PASSWORD=
# MONGO_ROOT_PASSWORD=
# REDIS_PASSWORD=
# GRAFANA_ADMIN_PASSWORD=
# NACOS_TOKEN_SECRET_KEY=

# hindsight（.21 域，agent 记忆服务）：compose 里写成 ${HINDSIGHT_LLM_PROVIDER:-mock} 等
# 默认 mock = 无钥即可起栈证"能跑"；接真实模型时取消注释（provider 见上游 README）
# HINDSIGHT_LLM_PROVIDER=openai
# HINDSIGHT_LLM_API_KEY=sk-xxx
# HINDSIGHT_LLM_MODEL=gpt-4o-mini
# hindsight 的外部存储后端（复用 pg 栈，DEC-55）：pre.sh 建 role/db + pgvector 扩展时用；make secrets 自动生成
# HINDSIGHT_DB_PASSWORD=
