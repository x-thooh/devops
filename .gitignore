# 运行时数据（plan §4 / DEC-10）：忽略内容但保留顶层 .gitkeep
**/.data/
!**/.data/.gitkeep

# 密钥与本地覆盖（plan §4）
env/.env

# 生成物（只改输入：ini / base/ / mise.toml / services/*/compose.yml）
/.generated/
/compose.generated.yml
/compose.yml
/backups/

# 本地工具链环境（mise.toml 是输入；.venv 与 mise 信任记录是生成物，DEC-51）
/.venv/
/.mise/

# 编辑器 / 系统噪音
.idea/
.DS_Store

# Python 字节码缓存（scripts/*.py 运行期生成，非输入）
__pycache__/
*.pyc
